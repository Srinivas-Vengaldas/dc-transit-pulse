{
  "name": "dc-transit-pulse-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Static showcase site for DC Transit Pulse, built from the exported gold snapshot.",
  "scripts": {
    "snapshot": "node scripts/copy-snapshot.mjs",
    "dev": "npm run snapshot && vite",
    "build": "npm run snapshot && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "papaparse": "^5.5.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.2.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
