{
  "name": "dc-transit-pulse",
  "description": "Collect WMATA bus GTFS-RT snapshots, then bronze -> silver -> gold.",
  "tags": {
    "project": "dc-transit-pulse"
  },
  "max_concurrent_runs": 1,
  "timeout_seconds": 3600,
  "schedule": {
    "quartz_cron_expression": "0 0 6-22/2 * * ?",
    "timezone_id": "America/New_York",
    "pause_status": "PAUSED"
  },
  "parameters": [
    {
      "name": "collect_polls",
      "default": "20"
    }
  ],
  "environments": [
    {
      "environment_key": "default",
      "spec": {
        "environment_version": "2",
        "dependencies": [
          "gtfs-realtime-bindings>=1.0.0",
          "requests>=2.31"
        ]
      }
    }
  ],
  "tasks": [
    {
      "task_key": "collect",
      "spark_python_task": {
        "python_file": "{repo}/orchestration/run_pipeline.py",
        "parameters": [
          "--step",
          "collect",
          "--run-id",
          "{{job.run_id}}",
          "--polls",
          "{{job.parameters.collect_polls}}"
        ]
      },
      "environment_key": "default",
      "max_retries": 1,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true,
      "timeout_seconds": 1800
    },
    {
      "task_key": "bronze",
      "spark_python_task": {
        "python_file": "{repo}/orchestration/run_pipeline.py",
        "parameters": [
          "--step",
          "bronze",
          "--run-id",
          "{{job.run_id}}"
        ]
      },
      "environment_key": "default",
      "max_retries": 2,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true,
      "timeout_seconds": 1800,
      "depends_on": [
        {
          "task_key": "collect"
        }
      ],
      "run_if": "ALL_DONE"
    },
    {
      "task_key": "silver",
      "spark_python_task": {
        "python_file": "{repo}/orchestration/run_pipeline.py",
        "parameters": [
          "--step",
          "silver",
          "--run-id",
          "{{job.run_id}}"
        ]
      },
      "environment_key": "default",
      "max_retries": 2,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true,
      "timeout_seconds": 1800,
      "depends_on": [
        {
          "task_key": "bronze"
        }
      ]
    },
    {
      "task_key": "gold",
      "spark_python_task": {
        "python_file": "{repo}/orchestration/run_pipeline.py",
        "parameters": [
          "--step",
          "gold",
          "--run-id",
          "{{job.run_id}}"
        ]
      },
      "environment_key": "default",
      "max_retries": 2,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true,
      "timeout_seconds": 1800,
      "depends_on": [
        {
          "task_key": "silver"
        }
      ]
    },
    {
      "task_key": "quality",
      "spark_python_task": {
        "python_file": "{repo}/orchestration/run_pipeline.py",
        "parameters": [
          "--step",
          "quality",
          "--run-id",
          "{{job.run_id}}"
        ]
      },
      "environment_key": "default",
      "max_retries": 0,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": false,
      "timeout_seconds": 1800,
      "depends_on": [
        {
          "task_key": "gold"
        }
      ]
    },
    {
      "task_key": "weather",
      "spark_python_task": {
        "python_file": "{repo}/orchestration/run_pipeline.py",
        "parameters": [
          "--step",
          "weather",
          "--run-id",
          "{{job.run_id}}"
        ]
      },
      "environment_key": "default",
      "max_retries": 2,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true,
      "timeout_seconds": 1800
    }
  ]
}
