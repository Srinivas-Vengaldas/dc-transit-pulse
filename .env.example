# Copy to .env and fill in real values. .env is git-ignored; this file is not.
# Load it in your shell with:  set -a; source .env; set +a

# WMATA developer portal -> Profile -> Primary key
WMATA_API_KEY=your-wmata-primary-key-here

# GTFS-Realtime bus feeds (sent with header `api_key`)
WMATA_VEHICLE_POSITIONS_URL=https://api.wmata.com/gtfs/bus-gtfsrt-vehiclepositions.pb
WMATA_TRIP_UPDATES_URL=https://api.wmata.com/gtfs/bus-gtfsrt-tripupdates.pb

# GTFS static schedule zip (check the exact URL in the WMATA portal)
WMATA_BUS_STATIC_URL=https://api.wmata.com/gtfs/bus-gtfs-static.zip
STATIC_DIR=./data/static

# Producer settings
POLL_INTERVAL_SECONDS=30
# Where the producer writes raw snapshots (local folder for now)
LANDING_DIR=./data/landing
